# Upstreams -------------------------------------------------------------------
# Restricted-RPC monerod (read-only: no /start_mining, no wallet calls).
MONEROD_RPC=http://127.0.0.1:18089

# Optional: a whitelisted full-RPC helper, used only for /get_transaction_pool.
# Monero v0.18.5.3+ removed that method from the restricted RPC set. Point this
# at your own helper; when it is unreachable, xmr_mempool_health still answers
# from /get_transaction_pool_stats and reports pool_source=unavailable.
XMR_HELPER_RPC=http://127.0.0.1:18085/rpc

# Optional: monero-wallet-rpc (needed only by the three view-key tools:
# xmr_verify_tx_proof, xmr_verify_payment, xmr_merchant_report).
# 18083 is monero-wallet-rpc's own mainnet default; xmr.pub runs it on 18084.
WALLET_RPC_HOST=127.0.0.1
WALLET_RPC_PORT=18083
WALLET_RPC_PATH=/json_rpc
WALLET_RPC_USER=xmrpub-mcp
WALLET_RPC_PASS=change-me

# Local state -----------------------------------------------------------------
USAGE_DB=/data/usage.db
API_KEY_FILE=/data/api_keys.txt
MCP_PORT=8080

# Rate limits (requests per minute; keys only raise the ceiling, they are not billing)
ANON_RATE_PER_MIN=120
KEY_RATE_PER_MIN=600

# Optional x402 payment layer. When mcpserver.py cannot import x402_pay, the
# free tools work and the four paid tools answer with an MCP payment-required
# result instead of running.
# RB_X402_CONFIG=/data/x402.json
